# OpenAI (usado por LiteLLM y por los embeddings del RAG)
OPENAI_API_KEY=
# El nombre del modelo debe incluir el prefijo del proveedor para LiteLLM
MODEL_NAME=openai/gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant Cloud (RAG)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=palermia_docs

# NeonDB / Postgres (consultado por el servidor MCP)
DATABASE_URL=postgresql://usuario:password@host.neon.tech/neondb?sslmode=require

# Servidor MCP (HTTP). Debe coincidir con host/puerto/path de mcp_server/server.py
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
